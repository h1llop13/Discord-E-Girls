# Discord credentials and server configuration
DISCORD_TOKEN=replace_with_bot_token
DISCORD_APPLICATION_ID=replace_with_application_id
DISCORD_GUILD_ID=replace_with_server_id
COMMAND_CHANNEL_ID=replace_with_command_channel_id
ORDER_LOG_CHANNEL_ID=replace_with_order_log_channel_id
PRIVATE_CATEGORY_ID=replace_with_private_category_id
CURATOR_ROLE_ID=replace_with_curator_role_id
CLIENT_ROLE_ID=replace_with_client_role_id
EGIRL_ROLE_ID=replace_with_egirl_role_id

# PostgreSQL connection string
DATABASE_URL=postgresql://discord_bot:change_me@localhost:5432/discord_bot
# Optional: a separate disposable database used only by npm run test:db
TEST_DATABASE_URL=postgresql://discord_bot:change_me@localhost:5432/discord_bot_test

# Use true only for short local/manual tests
TEST_MODE=false
